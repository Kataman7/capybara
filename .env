# Replace these values with your own keys and tokens.
# Copy this file to .env and never commit the real .env to git.

# Discord Bot Token
DISCORD_TOKEN=OTU5NDI3MDEyMTk0MzQ5MDg4.GY1ddF.n60yG8Y4TeYaLqkKu8xfXUQEn1smfSjymtUPgg

# OpenAI API Key (deprecated) -- no longer supported. Move your value to AI_API_KEY.
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Node environment
NODE_ENV=development

# Optional AI model to use for chat (e.g. gpt-3.5-turbo, gpt-4o, gpt-4o-mini, or third-party model names supported by the library)
AI_MODEL=deepseek-chat

# DB configuration for MySQL
DB_HOST=db
DB_NAME=capybara_db
DB_USER=root
DB_PASS=capybararoot
# Mot de passe root MySQL (obligatoire pour le démarrage du conteneur)
DB_ROOT_PASS=capybararoot

# Faith update cooldown in minutes
FAITH_UPDATE_COOLDOWN_MINUTES=1

# Settings file (mandatory for text prompts/messages) - default is the project root
SETTINGS_FILE=./settings.json

# Role ID which will be given for punishments (optional). If omitted, punishment role won't be applied.
## Note: punishment role and messages are now defined in `settings.json` under `punishRoleId` and `punishMessages`.

# For third-party OpenAI-compatible providers (Deepseek etc.), set the API key and an optional base URL here.
# For example, Deepseek: AI_API_BASE_URL=https://api.deepseek.com and AI_API_KEY=<your key>
AI_API_KEY=sk-3adf6c220a7f46ecace0e96a4fcccb46
AI_API_BASE_URL=https://api.deepseek.com
