# Example environment variables for the Capybara bot
# Copy this file to `.env` (local development) and populate the values.

# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Node environment
NODE_ENV=development

# Optional AI model to use for chat (e.g. gpt-3.5-turbo, gpt-4o, gpt-4o-mini, or third-party model names supported by the library)
AI_MODEL=deepseek-chat

# DB configuration for MySQL
DB_HOST=db
DB_NAME=capybara_db
DB_USER=root
DB_PASS=change_this_to_a_strong_password
# Root MySQL password (required when starting the container)
DB_ROOT_PASS=change_this_to_a_strong_password

# Faith update cooldown in minutes
FAITH_UPDATE_COOLDOWN_MINUTES=10

# Watermelon cooldown in hours (time between farming attempts)
WATERMELON_COOLDOWN_HOURS=1

# Settings file (mandatory for text prompts/messages) - default is the project root
SETTINGS_FILE=./settings.json

# For third-party OpenAI-compatible providers (Deepseek etc.), set the API key and an optional base URL here.
# For example, Deepseek: AI_API_BASE_URL=https://api.deepseek.com and AI_API_KEY=<your key>
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=https://api.deepseek.com

# Crypto ID for /trade command (e.g. pepe, bitcoin, ethereum)
CRYPTO_ID=pepe
CRYPTO_PRICE_CACHE_MS=5000
