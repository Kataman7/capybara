# Replace these values with your own keys and tokens.
# Copy this file to .env and never commit the real .env to git.

# Discord Bot Token
DISCORD_TOKEN=OTU5NDI3MDEyMTk0MzQ5MDg4.GY1ddF.n60yG8Y4TeYaLqkKu8xfXUQEn1smfSjymtUPgg

# AI API Key (preferred) — works with OpenAI or other OpenAI-compatible providers
# Example: AI_API_KEY=sk-xxxxx
AI_API_KEY=your_ai_api_key_here

# For third-party OpenAI-compatible providers (Deepseek etc.), set an optional base URL here.
# For example, Deepseek: AI_API_BASE_URL=https://api.deepseek.com
AI_API_BASE_URL=

# Note: older variables like OPENAI_API_KEY or OPENAI_KEY are no longer supported.
# Use `AI_API_KEY` instead.

# Optional: Node environment
NODE_ENV=development

# Optional AI model to use for chat (e.g. gpt-3.5-turbo, gpt-4o, gpt-4o-mini, deepseek-chat, or other model names)
AI_MODEL=gpt-3.5-turbo

# DB configuration for MySQL
DB_HOST=db
DB_NAME=capybara_db
DB_USER=root
DB_PASS=your_db_password_here
DB_ROOT_PASS=your_db_password_here

# Faith update cooldown in minutes
FAITH_UPDATE_COOLDOWN_MINUTES=60

# Settings file (mandatory for text prompts/messages) - default is the project root
SETTINGS_FILE=./settings.json
